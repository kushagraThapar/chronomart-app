{
  "name": "bulk-ingest",
  "durationSeconds": 30,
  "concurrency": 4,
  "rampSeconds": 0,
  "steps": [
    {
      "op": "bulk",
      "container": "Inventory",
      "weight": 100,
      "params": {
        "op": "upsert",
        "partitionKey": "seller-001",
        "batchSize": 20,
        "pkField": "sellerId",
        "idPrefix": "wl-bulk-inv-",
        "template": {
          "stockOnHand": 50,
          "reorderPoint": 10
        }
      }
    }
  ]
}
